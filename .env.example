# Local development only. Replace these values before running the stack.
DATABASE_PASSWORD=replace-with-a-local-development-password

# Local development only. Replace with a random value of at least 32 characters.
BANK_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Set true to make the fake bank fail and exercise retry/circuit-breaker behavior.
BANK_SIMULATOR_FAIL_REQUESTS=false
